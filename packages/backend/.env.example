# =============================================================================
# ECG Arrhythmia Classification Studio - Backend Environment Configuration
# =============================================================================
# This file should be renamed to `.env` and populated with production values.
# Never commit real secrets to version control.

# =============================================================================
# Server Configuration
# =============================================================================
# Application name and version
APP_NAME=ECG Arrhythmia Classification Studio
APP_VERSION=2.0.0

# Debug mode: set to false for production
DEBUG=false

# Host and port configuration
HOST=0.0.0.0
PORT=8000

# =============================================================================
# CORS Configuration (Strict Origin Validation)
# =============================================================================
# Allowed origins for Next.js frontend - comma-separated list
# In production, replace with your actual frontend domain
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL (used for API callbacks, redirect URIs)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# File Upload Security
# =============================================================================
# Maximum upload size in bytes (10MB = 10*1024*1024)
MAX_UPLOAD_SIZE=10485760

# Allowed file extensions for ECG signal uploads
# Supported: .csv .npy .mat .json
ALLOWED_SIGNAL_EXTENSIONS=.csv,.npy,.mat,.json

# =============================================================================
# ML Pipeline Configuration
# =============================================================================
# ECG sampling rate in Hz (must match frontend EXPECTED_SAMPLING_RATE)
SAMPLING_RATE=360

# CNN input shape: (channels, height, width)
MODEL_INPUT_SHAPE=1,128,128

# Grad-CAM configuration
GRADCAM_HEATMAP_SIZE=128
GRADMAP_COLORMAP=jet

# =============================================================================
# Security Hardening
# =============================================================================
# API rate limit per minute (e.g., "100/min", "500/hour")
API_RATE_LIMIT=100/min

# Enable security headers middleware (X-Content-Type-Options, X-Frame-Options, etc.)
ENABLE_SECURITY_HEADERS=true

# =============================================================================
# Grad-CAM & Explainability
# =============================================================================
# OpenCV colormap for Grad-CAM heatmap visualization
# Options: jet, hot, cool, winter, summer, spring, autumn
GRADMAP_COLORMAP=jet

# =============================================================================
# Docker & Deployment
# =============================================================================
# Docker image tag override
DOCKER_TAG=latest

# =============================================================================
# Endpoint Configuration
# =============================================================================
# FastAPI base endpoint prefix
API_V1_STR=/api/v1

# Health check endpoint
HEALTH_ENDPOINT=/health

# =============================================================================
# Example .env file content (copy to .env and modify):
# =============================================================================
# APP_NAME=ECG Arrhythmia Classification Studio
# APP_VERSION=2.0.0
# DEBUG=false
# HOST=0.0.0.0
# PORT=8000
# BACKEND_CORS_ORIGINS=http://localhost:3000
# FRONTEND_URL=http://localhost:3000
# MAX_UPLOAD_SIZE=10485760
# ALLOWED_SIGNAL_EXTENSIONS=.csv,.npy,.mat,.json
# SAMPLING_RATE=360
# MODEL_INPUT_SHAPE=1,128,128
# GRADCAM_HEATMAP_SIZE=128
# GRADMAP_COLORMAP=jet
# API_RATE_LIMIT=100/min
# ENABLE_SECURITY_HEADERS=true
# GRADMAP_COLORMAP=jet
# DOCKER_TAG=latest
# API_V1_STR=/api/v1
# HEALTH_ENDPOINT=/health